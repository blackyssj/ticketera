# Variables del proyecto Supabase (se cargan en el panel, no en el repo).
# La anon key NO va acá: es pública y vive en app/config.js.

# Pasarela: "simulada" no cobra nada; "v2pro" cobra de verdad.
PASARELA=simulada

# Solo con PASARELA=v2pro. Comercio 1518 = BeePlay Stage.
V2PRO_URL=https://pay.scrum-technology.com/api/v2pro
V2PRO_LLAVE=
V2PRO_USUARIO=
V2PRO_PASS=

# El correo con el link a las entradas (enviar-entradas).
# Sin RESEND_API_KEY no se manda ningún correo: la función registra y sigue,
# y la pantalla de compra deja de prometerlo. No rompe la venta, pero el
# comprador que no vuelve de la pasarela se queda sin saber que tiene entradas.
RESEND_API_KEY=
# El remitente. Con el dominio sin verificar en Resend, solo sale a la casilla
# del dueño de la cuenta; para mandarle a cualquiera hay que verificar dominio.
CORREO_DESDE=Entradas <onboarding@resend.dev>
# La base del link que va en el correo. Sin esto apunta al Vercel de producción,
# que en un despliegue propio es el sitio equivocado.
SITIO_URL=https://ticketera-coral.vercel.app

# El secreto del barrido (barrer-pagos), el mismo que lleva el cron de la
# migración 0041 en su header x-barrido. Si está vacío la función contesta 403
# a todo y el barrido no emite ni avisa nada: las órdenes de quien no volvió de
# la pasarela se quedan pendientes con la plata cobrada.
BARRIDO_CLAVE=
