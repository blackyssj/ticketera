{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/orden", "destination": "/orden/index.html" },
    { "source": "/orden/(.*)", "destination": "/orden/index.html" },
    { "source": "/:organizador/:evento", "destination": "/index.html" }
  ]
}
