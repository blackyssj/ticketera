# Credenciales. La contraseña de la base vive acá y no se versiona nunca.
.credenciales
.env
.env.*
# Y cualquier cosa que TERMINE en .env: las dos reglas de arriba solo atrapan
# un archivo llamado `.env` o `.env.algo`, no uno llamado
# `ticketazo-env-para-el-equipo.env` — que es exactamente el nombre con el que
# el archivo circula por el equipo. Sin esta línea, copiarlo a la carpeta sin
# renombrarlo lo deja listo para subir, con la pasarela y la contraseña de la
# base adentro, a un repo público.
*.env
**/*.env
!.env.example

# Vercel: .env.local trae un token OIDC de corta vida y .vercel el link del
# proyecto. Ninguno de los dos es de nadie más.
.vercel/
**/.vercel/
.env.local
**/.env.local

node_modules/
.DS_Store
*.log

# Python deja esto al correr cualquier script de scripts/ — o sea, al hacer
# cualquier despliegue. Sin la regla le aparece como archivo nuevo a todo el
# que trabaje acá, y es basura de la máquina, no código.
__pycache__/
*.pyc

# Configuración local de los editores de JetBrains. Es de la máquina de cada
# uno: rutas, ventanas abiertas, preferencias. No le sirve a nadie más.
.idea/

# Worktrees de los agentes y el ledger del plan en curso: andamio, no codigo.
.claude/
.superpowers/

# El PAT de este repo: la ticketera vive en la cuenta de la empresa y
# ~/.supabase_pat puede tener el de otra. Nunca se versiona.
.pat

# El CSV con las claves que imprime crear-relacionadores.py, y la lista de
# gente que le entra. Son credenciales de personas reales y nombres de
# gente del equipo de un cliente: ninguna de las dos cosas se versiona.
claves-*.csv
relacionadores*.txt
